# Memos Platform API Token
# Memos platformu üzerinden profil ayarlarınızdan oluşturduğunuz Access Token (Erişim Anahtarı).
MEMOS_TOKEN="your_memos_access_token_here"

# Memos Platform API URL
# API isteklerinin yapılacağı uç nokta adresi. Varsayılan olarak googig.cloud yapısına ayarlanmıştır.
MEMOS_API_URL="https://memos.googig.cloud/api/v1/memos"

# ══════════════════════════════════════════════════════════════
# Haber-Kuratör Core Configuration
# All settings are optional — defaults work out of the box.
# ══════════════════════════════════════════════════════════════

# RSS fetching
# HABER_RSS_TIMEOUT=5
# HABER_RSS_MAX_WORKERS=8
# HABER_RSS_RETRY_DELAYS=1.0,2.0,4.0
# HABER_RSS_DELAY=0.3

# News filtering
# HABER_NEWS_MAX_AGE_HOURS=48

# Verification
# HABER_MIN_VERIFICATION_LEVEL=1

# Cache
# HABER_CACHE_ENABLED=true

# Version
# HABER_VERSION=3.1.0
